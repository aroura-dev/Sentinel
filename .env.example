# ===== Sentinel 本地环境变量模板 =====
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不会提交到仓库。
# Docker Compose 会自动读取项目根目录下的 .env。

# 基础设施密码（默认值仅用于本地开发，生产环境必须修改）
SENTINEL_DATABASE_PASSWORD=root123_A
SENTINEL_REDIS_PASSWORD=sentinel

# 通义千问 DashScope API Key（不设则 Agent 运行期降级到模板，应用仍可用）
DASHSCOPE_API_KEY=

# 微信开放平台 公众号 appId / secret（仅 test profile 使用，dev 不加载）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
