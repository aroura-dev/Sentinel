# ===== Sentinel 本地环境变量模板 =====
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不会提交到仓库。
# Docker Compose 会自动读取项目根目录下的 .env。

# 基础设施密码（默认值仅用于本地开发，生产环境必须修改）
SENTINEL_DATABASE_PASSWORD=root123_A
SENTINEL_REDIS_PASSWORD=sentinel

# 通义千问 DashScope API Key（不设则 Agent 运行期降级到模板，应用仍可用）
DASHSCOPE_API_KEY=

# 微信开放平台 公众号 appId / secret（仅 test profile 使用，dev 不加载）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 腾讯云短信（真实手机验证码）
SENTINEL_SMS_ENABLED=false
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_ENDPOINT=sms.tencentcloudapi.com
SENTINEL_SMS_DEV_RETURN_CODE=false
SENTINEL_SMS_CODE_TTL_SECONDS=300
SENTINEL_SMS_SEND_THROTTLE_SECONDS=60
SENTINEL_SMS_MAX_ATTEMPTS=5
SENTINEL_SMS_DAILY_LIMIT=10

# 邮箱验证码（SMTP；QQ 邮箱请使用“SMTP 授权码”，不是邮箱登录密码）
SENTINEL_EMAIL_ENABLED=false
SENTINEL_EMAIL_SMTP_HOST=smtp.qq.com
SENTINEL_EMAIL_SMTP_PORT=465
SENTINEL_EMAIL_SMTP_USERNAME=
SENTINEL_EMAIL_SMTP_PASSWORD=
SENTINEL_EMAIL_FROM=
SENTINEL_EMAIL_SSL_ENABLED=true
SENTINEL_EMAIL_STARTTLS_ENABLED=false
SENTINEL_EMAIL_CONNECTION_TIMEOUT_SECONDS=10
SENTINEL_EMAIL_TIMEOUT_SECONDS=15
SENTINEL_EMAIL_CODE_TTL_SECONDS=300
SENTINEL_EMAIL_SEND_THROTTLE_SECONDS=30
SENTINEL_EMAIL_MAX_ATTEMPTS=5
SENTINEL_EMAIL_DAILY_LIMIT=20
