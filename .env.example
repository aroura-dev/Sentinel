# ===== Sentinel 本地环境变量模板 =====
# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，不会入库。
# 说明：DB 密码(root123_A) / Redis 密码(austin) 是 docker-compose 基建默认值，start-local.sh 默认即用，
#       无需在此设置；如需覆盖请同时修改 doc/docker 下的 compose 与 start-local.sh。

# 通义千问 DashScope API Key（不设则 Agent 运行期降级到模板，应用仍可用）
DASHSCOPE_API_KEY=

# 微信开放平台 公众号 appId / secret（仅 test profile 使用，dev 不加载）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
