# ============================================================
# Sentinel 微服务栈环境变量模板
#
#   cp .env.example .env    # 然后按需修改
#
# .env 已被 .gitignore 忽略 —— 不要把真实口令提交进仓库。
# compose.infra.yml 用 ${VAR:?} 强制要求这些变量必须存在，
# 缺失时会直接报错而不是静默回退到空口令。
#
# 下列默认值仅用于本地演示。生产环境请全部替换，并通过
# 密钥管理服务（Vault/KMS/云厂商 Secrets Manager）注入。
# ============================================================

# MySQL root 口令。
# 注意：compose 已不再设置 MYSQL_ROOT_HOST，因此 root 仅能通过
# 容器内 socket（localhost）登录，无法从网络上其他主机连接。
MYSQL_ROOT_PASSWORD=root123_A

# 各服务库的最小权限账号口令。
# 每个库由 init 目录下的 99_app_user.sh 创建同名账号
# （sentinel_auth / sentinel_msg / sentinel_logistics / sentinel_agent），
# 只授予该库的 SELECT/INSERT/UPDATE/DELETE，不含 DDL 与跨库权限。
MYSQL_APP_PASSWORD=root123_A

# Redis 口令（会话与消息去重共用）
REDIS_PASSWORD=sentinel

# ---- 分布式追踪（可选）----
# 日志里的 traceId/spanId 始终有效，无需任何配置。
# 只有想把链路拓扑上报到 Zipkin 界面时才需要：把下面设为 true，
# 并用 --profile observability 启动（该 profile 提供 zipkin 与 prometheus 容器）。
ZIPKIN_ENABLED=false
# 采样率：本地演示用 1.0（全采）；生产按流量下调，否则存储成本会失控。
SLEUTH_SAMPLING_PROBABILITY=1.0

# ---- 演示台发布端口（可选覆盖）----
# 默认 5175（README/docs/up.sh 均按此写），容器内 nginx 监听 5173。
# Windows 下 Hyper-V/WSL 会保留成段端口，落在保留段里的端口会以
# "An attempt was made to access a socket in a way forbidden by its access permissions" 失败。
# 查看保留段：netsh interface ipv4 show excludedportrange protocol=tcp
# 命中时在 .env 里改成本机可用端口即可，例如：
# FRONTEND_PORT=5275
#FRONTEND_PORT=5175

# 服务间身份签名密钥。
# 网关用它给注入的 X-User-Name / X-User-Role 签名，各业务服务校验通过才认这两个头。
# 没有它，同一 compose 网络内（或被攻陷的任一容器）就能伪造身份头冒充任意角色 ——
# agent-service 的 /internal/** 更是连 @RequireRole 都没有。
# 生产环境必须替换为足够长的随机值，并通过密钥管理服务注入。
SENTINEL_INTERNAL_SECRET=dev-internal-secret-change-me

# ---- Nacos（注册中心 + 配置中心）----
# 容器内各服务用这个地址（compose 服务名即 DNS）。
NACOS_SERVER_ADDR=nacos:8848
#
# 看控制台：基座不发布 8848，需叠加 dev 覆盖（只绑回环）：
#   docker compose -f compose.infra.yml -f compose.dev.yml up -d
#   然后开 http://127.0.0.1:8848/nacos  （Nacos 2.x 默认账号 nacos/nacos）
#
# 宿主机直跑 jar 联调时，把 NACOS_SERVER_ADDR 覆盖成 127.0.0.1:8848 再启动；
# 注意 dev 覆盖必须同时放开 9848/9849，否则客户端 gRPC 连不上会报 "server check fail"。
#
# 单个服务要临时停用注册/配置（例如排查"注册中心挂掉拖垮启动"）：
#   设 NACOS_DISCOVERY_ENABLED=false / NACOS_CONFIG_ENABLED=false
#
# 要给 Nacos 开鉴权：置 NACOS_AUTH_ENABLE=true 并在各服务配 spring.cloud.nacos.username/password。
